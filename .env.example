# ---------------------------------------------------------------------------
# MUTAZOLOGY environment variables
# Copy to .env.local for local dev, and add these in Vercel → Project Settings.
# The site runs WITHOUT these (falls back to bundled seed content); add them to
# switch to a live Supabase database.
# ---------------------------------------------------------------------------

# Browser-safe (protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# SERVER ONLY — never expose to the browser. Used for admin writes / view counts.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Change your domain freely here (used for canonical URLs + OG images)
NEXT_PUBLIC_SITE_URL=https://mutazology.com
